# ==============================================
# SENTRY CONFIGURATION
# ==============================================

# Required: Your Sentry DSN (from your Sentry project settings)
SENTRY_DSN=https://your-dsn@o123456.ingest.sentry.io/7654321

# Environment name (used for filtering in Sentry)
SENTRY_ENVIRONMENT=development

# Release version (used for tracking deploys and commits)
SENTRY_RELEASE=checkout-api@1.0.0

# Performance monitoring sample rate (0.0 to 1.0)
# 1.0 = 100% of transactions are sent to Sentry
SENTRY_TRACES_SAMPLE_RATE=1.0

# Profiling sample rate (0.0 to 1.0)
# 1.0 = 100% of transactions include performance profiles
SENTRY_PROFILES_SAMPLE_RATE=1.0

# ==============================================
# SERVER CONFIGURATION
# ==============================================

# Server port
PORT=3000

# Node environment
NODE_ENV=development
